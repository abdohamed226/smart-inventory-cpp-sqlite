{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure SmartInventory",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build",
        "-G",
        "Ninja"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build SmartInventory",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build"
      ],
      "dependsOn": [
        "Configure SmartInventory"
      ],
      "group": "build"
    }
  ]
}